#!/bin/sh
set -e

# Run after default-settings-chn, which otherwise selects mirrors.vsean.net.
# Replace only the base URL; retain release/snapshot, target and ABI paths.
mirror='https://mirrors.nju.edu.cn/immortalwrt'
uci -q get 'system.@imm_init[0]' >/dev/null || uci -q add system imm_init >/dev/null
for feeds in /etc/opkg/distfeeds.conf /etc/apk/repositories.d/distfeeds.list; do
  [ -f "$feeds" ] || continue
  case "$feeds" in
    /etc/opkg/*) option=opkg_mirror ;;
    /etc/apk/*) option=apk_mirror ;;
  esac
  sed -i \
    -e "s|https\?://downloads\.immortalwrt\.org/|$mirror/|g" \
    -e "s|https\?://mirrors\.vsean\.net/openwrt/|$mirror/|g" "$feeds"
  uci set "system.@imm_init[0].$option=$mirror"
done
uci commit system
exit 0
